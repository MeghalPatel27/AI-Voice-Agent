# DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# SERVER
PORT=5001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
APP_PUBLIC_URL="https://your-public-url.example.com"
PUBLIC_WEBHOOK_URL="https://your-public-url.example.com"
JWT_SECRET="replace_me"

# OPENAI TEXT FEATURES (non-voice)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEXT_MODEL="gpt-4o-mini"
OPENAI_DECISION_TIMEOUT_MS=15000

# HUME EVI VOICE AGENT
HUME_API_KEY=""
HUME_CONFIG_ID=""
HUME_WEBHOOK_SIGNING_KEY=""
HUME_API_BASE_URL="https://api.hume.ai"
HUME_WEBHOOK_PUBLIC_URL="https://your-public-url.example.com"
HUME_DATA_RETENTION_USER_CONFIRMED=false
VOICE_COMPANY_ID=""
ALLOW_DEV_SCHEDULED_CONTEXT_SEED=false
DEV_SUPABASE_PROJECT_REF="tqmwrmlswbwngblxkibm"
VOICE_WEBHOOK_SECRET="replace_me"

# Hume custom-tool deadlines (Control Plane delivery)
HUME_TOOL_EXECUTION_TIMEOUT_MS=1500
HUME_CONTROL_PLANE_TIMEOUT_MS=1500
HUME_TOOL_DELIVERY_MAX_ATTEMPTS=3
HUME_TOOL_DELIVERY_RETRY_BASE_MS=200
HUME_CONTEXT_CACHE_TTL_SECONDS=120

# TWILIO TELEPHONY
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# LIVE E2E CALL SAFETY GATE (development only)
LIVE_E2E_CALL_TESTS=false
LIVE_TEST_RECIPIENT=""
LIVE_TEST_CONSENT_CONFIRMED=false

POST_CALL_ANALYSIS_WORKER_ENABLED=true
POST_CALL_ANALYSIS_WORKER_INTERVAL_MS=5000
HUME_SYNC_WORKER_ENABLED=true
HUME_SYNC_WORKER_INTERVAL_MS=5000
HUME_SYNC_WORKER_BATCH_LIMIT=4
HUME_SYNC_WORKER_STALE_PROCESSING_MS=120000

# Call lifecycle reconciliation (stale active Calls / Tasks stuck in Doing)
CALL_RECONCILE_STALE_ACTIVE_MINUTES=45
POST_CALL_ANALYSIS_SETTLE_MS=8000
POST_MEETING_HANGUP_GRACE_MS=10000
POST_MEETING_HANGUP_MAX_ATTEMPTS=2
POST_MEETING_HANGUP_RETRY_MS=2000
