generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum ConversationChannel {
  AI_CALL
  WHATSAPP
  WEBSITE_CHAT
}

enum ConversationStatus {
  NEW
  IN_PROGRESS
  FOLLOW_UP
  CONVERTED
  HUMAN_REQUIRED
  LOST
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  LIVE
  COMPLETED
  NO_ANSWER
  BUSY
  CANCELED
  FAILED
  MISSED
  TRANSFERRED
}

enum TaskStatus {
  OPEN
  DOING
  BLOCKED
  DONE
}

enum AgentStatus {
  LIVE
  TESTING
  PAUSED
  NOT_CONNECTED
}

enum Industry {
  HOSPITAL
  CLINIC
  HOTEL
  RESTAURANT
  REAL_ESTATE
  OTHER
}

enum OutboundStatus {
  PENDING
  SENT
  FAILED
}

enum CallPostAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  INSUFFICIENT_DATA
}

enum TelephonyProvider {
  TWILIO
}

enum VoiceAgentProvider {
  OPENAI_REALTIME
  HUME_EVI
  LEGACY_ELEVENLABS
  UNKNOWN
}

enum ProviderSyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RecordingReconstructionStatus {
  QUEUED
  IN_PROGRESS
  COMPLETE
  ERROR
  CANCELED
  NOT_REQUESTED
}

enum CallIntentLevel {
  VERY_HIGH
  HIGH
  MEDIUM
  LOW
  NOT_INTERESTED
  UNKNOWN
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  MEETING_REQUESTED
  MEETING_BOOKED
  QUOTATION_SENT
  WON
  LOST
}

enum PreferredLanguage {
  AUTO
  ENGLISH
  HINDI
  GUJARATI
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingAcceptanceStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
}

enum BookingOutcome {
  PENDING
  WON
  LOST
  FOLLOW_UP
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  Industry @default(OTHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users                  User[]
  customers              Customer[]
  conversations          Conversation[]
  tasks                  Task[]
  aiAgents               AiAgent[]
  bookings               Booking[]
  settings               CompanySettings?
  outboundMessages       OutboundMessage[]
  knowledgeItems         KnowledgeItem[]
  crmStages              CrmStage[]
  handoffRules           HandoffRule[]
  notificationRules      NotificationRule[]
  auditLogs              AuditLog[]
  integrationConnections IntegrationConnection[]
  callPostAnalyses       CallPostAnalysis[]
}

model CompanySettings {
  id        String @id @default(cuid())
  companyId String @unique

  businessType String?
  address      String?
  city         String?
  country      String?
  timezone     String? @default("Asia/Kolkata")
  websiteUrl   String?
  brandTone    String?

  defaultLanguage    String? @default("English")
  supportedLanguages Json?

  businessHours Json?
  closedDays    Json?

  mainWhatsappNumber        String?
  mainCallNumber            String?
  callForwardingNumber      String?
  emergencyEscalationNumber String?

  whatsappNumber  String?
  escalationPhone String?
  handoverRules   String?
  aiTone          String?
  webhookSecret   String? @unique

  aiName                String? @default("AI Assistant")
  aiReplyMode           String? @default("DRAFT_ONLY")
  aiReplyLength         String? @default("MEDIUM")
  aiConfidenceThreshold Int     @default(75)
  aiAllowedActions      Json?
  aiRestrictedActions   Json?
  aiFallbackResponse    String?

  channelSettings      Json?
  handoffSettings      Json?
  notificationSettings Json?
  taskWorkflowSettings Json?
  securitySettings     Json?
  billingSettings      Json?

  whatsappProviderMode       String? @default("mock")
  whatsappPhoneNumberId      String?
  whatsappAccessToken        String?
  whatsappBusinessAccountId  String?
  whatsappGraphApiVersion    String? @default("v20.0")
  whatsappWebhookVerifyToken String?

  voiceProviderMode   String? @default("mock")
  voiceProviderName   String? @default("mock")
  voiceApiKey         String?
  voiceAgentId        String?
  voiceFromNumber     String?
  voiceTransferNumber String?
  voiceWebhookSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model IntegrationConnection {
  id        String @id @default(uuid())
  companyId String

  provider String
  channel  ConversationChannel?

  status        AgentStatus @default(NOT_CONNECTED)
  displayName   String?
  accountId     String?
  phoneNumber   String?
  webhookUrl    String?
  mode          String?
  lastCheckedAt DateTime?
  lastEventAt   DateTime?
  lastError     String?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@index([provider])
  @@index([channel])
  @@index([status])
}

model User {
  id        String   @id @default(uuid())
  companyId String
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)

  isActive         Boolean   @default(true)
  deactivatedAt    DateTime?
  department       String?
  jobTitle         String?
  workloadCapacity Int       @default(8)
  permissions      Json?
  lastActiveAt     DateTime?
  twoFactorEnabled Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTasks        Task[]    @relation("TaskAssignee")
  assignedConversations Conversation[] @relation("ConversationAssignee")
  assignedCalls        Call[]    @relation("CallAssignee")
  assignedBookings     Booking[] @relation("BookingAssignee")
  acceptedBookings     Booking[] @relation("BookingAcceptedBy")

  @@index([companyId])
  @@index([role])
  @@index([isActive])
}

model Customer {
  id        String  @id @default(uuid())
  companyId String
  fullName  String?
  phone     String
  email     String?
  source    String?

  leadScore           Int?
  leadStage           LeadStage?
  requirementSummary  String?
  requirementDetails  Json?
  preferredLanguage   PreferredLanguage?
  businessType        String?
  budget              String?
  timeline            String?
  lastSeenAt          DateTime?
  lastContactAt       DateTime?
  notes               String?
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  tasks            Task[]
  bookings         Booking[]
  outboundMessages OutboundMessage[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([phone])
  @@index([email])
  @@index([source])
  @@index([leadStage])
  @@index([leadScore])
  @@index([updatedAt])
}

model Conversation {
  id         String  @id @default(uuid())
  companyId  String
  customerId String?

  channel  ConversationChannel
  status   ConversationStatus  @default(NEW)
  priority Priority            @default(MEDIUM)

  intent         String?
  aiSummary      String?
  nextAction     String?
  aiConfidence   Int     @default(0)
  humanNeeded    Boolean @default(false)
  bookingCreated Boolean @default(false)
  assignedUserId String?

  provider           String?
  providerThreadId   String?
  providerContactId  String?
  providerExternalId String?

  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  messages         Message[]
  calls            Call[]
  tasks            Task[]
  bookings         Booking[]
  outboundMessages OutboundMessage[]

  @@index([companyId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([channel])
  @@index([status])
  @@index([priority])
  @@index([humanNeeded])
  @@index([provider])
  @@index([providerThreadId])
  @@index([providerExternalId])
  @@index([createdAt])
  @@index([updatedAt])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderType     MessageSender
  body           String

  provider          String?
  providerMessageId String?
  providerStatus    String?
  mediaUrl          String?
  mediaType         String?
  metadata          Json?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderType])
  @@index([provider])
  @@index([providerMessageId])
  @@index([providerStatus])
  @@index([createdAt])
}

model Call {
  id             String @id @default(uuid())
  conversationId String

  phone           String
  durationSeconds Int        @default(0)
  transcript      String?
  status          CallStatus @default(COMPLETED)

  provider       String?
  providerCallId String? @unique
  direction      String? @default("INBOUND")
  telephonyProvider  TelephonyProvider?    @default(TWILIO)
  voiceAgentProvider VoiceAgentProvider?   @default(UNKNOWN)
  twilioCallSid      String?
  humeChatId         String?               @unique
  humeChatGroupId    String?
  humeConfigId       String?
  humeEndReason      String?
  transcriptSyncStatus ProviderSyncStatus? @default(PENDING)
  humeSyncStatus       ProviderSyncStatus? @default(PENDING)
  recordingReconstructionStatus RecordingReconstructionStatus? @default(NOT_REQUESTED)
  expressionAnalysisStatus       ProviderSyncStatus?            @default(PENDING)
  providerMetadataVersion        String?

  recordingUrl             String?
  recordingSid             String?
  recordingStatus          String?
  recordingDurationSeconds Int?
  recordingChannels        Int?
  recordingSource          String?
  recordingAvailableAt     DateTime?

  startedAt DateTime?
  endedAt   DateTime?
  endReason String?

  failureReason String?
  metadata      Json?

  assignedUserId    String?
  purpose           String?
  notes             String?
  nextAction        String?
  preferredLanguage PreferredLanguage?
  preferredCallTime DateTime?
  summary           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  conversation           Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedUser           User?                 @relation("CallAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  postAnalysis           CallPostAnalysis?
  humeExpressionAnalysis HumeExpressionAnalysis?
  humeSyncJobs           HumeChatSyncJob[]
  humeToolCalls          HumeToolCallReceipt[]
  bookings               Booking[]

  @@index([conversationId])
  @@index([assignedUserId])
  @@index([phone])
  @@index([status])
  @@index([provider])
  @@index([providerCallId])
  @@index([twilioCallSid])
  @@index([humeChatId])
  @@index([humeChatGroupId])
  @@index([telephonyProvider])
  @@index([voiceAgentProvider])
  @@index([recordingSid])
  @@index([createdAt])
  @@index([updatedAt])
}

model HumeWebhookReceipt {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  eventType      String
  chatId         String?
  callId         String?
  companyId      String?
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([eventType])
  @@index([chatId])
  @@index([callId])
  @@index([companyId])
  @@index([createdAt])
}

model HumeToolCallReceipt {
  id         String   @id @default(uuid())
  toolCallId String   @unique
  chatId     String
  callId     String
  companyId  String
  toolName   String
  status     String
  error      String?

  responseRequired       Boolean  @default(true)
  businessStatus         String   @default("PENDING")
  deliveryStatus         String   @default("PENDING")
  deliveryAttempts       Int      @default(0)
  receivedAt             DateTime @default(now())
  executionStartedAt     DateTime?
  executionCompletedAt   DateTime?
  responseSendStartedAt  DateTime?
  responseAcceptedAt     DateTime?
  /// Bounded Tool Response / Tool Error payload for safe redelivery (never log raw).
  responsePayload        Json?
  errorCategory          String?
  lastDeliveryError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([callId])
  @@index([companyId])
  @@index([toolName])
  @@index([deliveryStatus])
  @@index([businessStatus])
}

model HumeCallContextCache {
  id        String   @id @default(uuid())
  callId    String
  companyId String
  chatId    String?
  /// Bounded context snapshot; never contains secrets.
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, callId])
  @@index([chatId])
  @@index([expiresAt])
  @@index([companyId])
}

model HumeChatSyncJob {
  id            String           @id @default(uuid())
  callId         String
  chatId         String
  companyId      String
  status         ProviderSyncStatus @default(PENDING)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, chatId])
  @@index([status, nextAttemptAt])
  @@index([chatId])
  @@index([companyId])
}

model HumeExpressionAnalysis {
  id                    String           @id @default(uuid())
  callId                 String           @unique
  companyId              String
  chatId                 String
  status                 ProviderSyncStatus @default(PENDING)
  userTurnCount          Int              @default(0)
  averageScores          Json?
  topExpressions         Json?
  expressionTimeline     Json?
  insightSummary         String?
  rawSchemaVersion       String?
  failureReason          String?
  completedAt            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([chatId])
  @@index([status])
}

model CallPostAnalysis {
  id        String @id @default(uuid())
  companyId String
  callId    String @unique

  status CallPostAnalysisStatus @default(PENDING)

  intentLevel CallIntentLevel?
  intentScore Int?
  confidence  Float?

  requirementSummary String?
  requirementDetails Json?
  evidenceSignals    Json?

  promptVersion String?
  modelName     String?

  attemptCount         Int       @default(0)
  nextAttemptAt        DateTime?
  processingStartedAt  DateTime?
  completedAt          DateTime?
  failureCode          String?
  failureMessage       String?
  truncatedTranscript  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  call    Call    @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status, nextAttemptAt])
  @@index([status, processingStartedAt])
  @@index([createdAt])
}

model Task {
  id             String  @id @default(uuid())
  companyId      String
  conversationId String?
  customerId     String?
  assignedUserId String?

  title         String
  description   String?
  owner         String?
  aiNotes       String?
  blockedReason String?
  dueAt         DateTime?
  priority      Priority   @default(MEDIUM)
  status        TaskStatus @default(OPEN)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser User?         @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([conversationId])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@index([createdAt])
}

model AiAgent {
  id        String @id @default(cuid())
  companyId String

  name         String
  channel      ConversationChannel
  status       AgentStatus         @default(NOT_CONNECTED)
  language     String?
  instructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([channel])
  @@index([status])
}

model Booking {
  id             String  @id @default(uuid())
  companyId      String
  customerId     String?
  conversationId String?
  callId         String?

  title            String
  dateTime         DateTime?
  timezone         String?
  purpose          String?
  status           BookingStatus           @default(REQUESTED)
  acceptanceStatus BookingAcceptanceStatus @default(PENDING_ACCEPTANCE)
  outcome          BookingOutcome          @default(PENDING)
  assignedUserId   String?
  acceptedByUserId String?
  acceptedAt       DateTime?
  notes            String?
  proposalSent     Boolean                 @default(false)
  proposalSentAt   DateTime?
  nextAction       String?
  cancelledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  call         Call?         @relation(fields: [callId], references: [id], onDelete: SetNull)
  assignedUser User?         @relation("BookingAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?         @relation("BookingAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@index([conversationId])
  @@index([callId])
  @@index([assignedUserId])
  @@index([acceptedByUserId])
  @@index([status])
  @@index([acceptanceStatus])
  @@index([outcome])
  @@index([proposalSent])
  @@index([dateTime])
  @@index([createdAt])
}

model OutboundMessage {
  id             String  @id @default(uuid())
  companyId      String
  conversationId String?
  customerId     String?

  channel ConversationChannel
  toPhone String
  body    String
  status  OutboundStatus      @default(PENDING)

  provider          String?
  providerMessageId String?
  errorMessage      String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([conversationId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@index([toPhone])
  @@index([provider])
  @@index([providerMessageId])
  @@index([createdAt])
}

model KnowledgeItem {
  id        String @id @default(cuid())
  companyId String

  title    String
  category String @default("GENERAL")
  content  String

  isActive Boolean @default(true)
  enabled  Boolean @default(true)

  sourceType String?
  fileUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([category])
  @@index([isActive])
  @@index([enabled])
}

model CrmStage {
  id        String @id @default(uuid())
  companyId String

  name      String
  color     String?
  order     Int     @default(0)
  isEnabled Boolean @default(true)

  requiredFields Json?
  automationRule Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isEnabled])
  @@index([order])
}

model HandoffRule {
  id        String @id @default(uuid())
  companyId String

  name                String
  condition           String
  action              String
  assignedUserId      String?
  notificationChannel String?
  priority            Priority @default(HIGH)
  isEnabled           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isEnabled])
  @@index([priority])
}

model NotificationRule {
  id        String @id @default(uuid())
  companyId String

  name       String
  event      String
  recipients Json?
  channels   Json?
  quietHours Json?
  isEnabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([event])
  @@index([isEnabled])
}

model AuditLog {
  id        String  @id @default(uuid())
  companyId String
  userId    String?

  action     String
  entityType String
  entityId   String?
  message    String
  metadata   Json?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
